{
  "name": "poultry-farm-feed-mill-management-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "tsx --test 'apps/web/**/*.test.{ts,tsx}' 'apps/mobile/test/*.test.ts' 'packages/*/test/*.test.ts' 'scripts/*.test.ts'",
    "dev:mobile": "pnpm --filter @poultry/mobile start",
    "mobile:env": "tsx scripts/prepare-mobile-env.ts",
    "dev:android": "pnpm --filter @poultry/mobile android",
    "build:android:local": "pnpm --filter @poultry/mobile exec expo run:android",
    "dev:web": "pnpm --filter @poultry/web dev",
    "dev:web:local": "tsx scripts/with-local-supabase.ts pnpm --filter @poultry/web dev",
    "build:web:local": "tsx scripts/with-local-supabase.ts pnpm --filter @poultry/web build",
    "start:web:local": "tsx scripts/with-local-supabase.ts pnpm --filter @poultry/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --ignore-unknown --write README.md docs apps packages scripts eas.json package.json tsconfig.base.json pnpm-workspace.yaml eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --ignore-unknown --check README.md docs apps packages scripts eas.json package.json tsconfig.base.json pnpm-workspace.yaml eslint.config.mjs .prettierrc.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db reset --yes && supabase test db && bash supabase/tests/004_admin_concurrency.sh && bash supabase/tests/007_role_assignment_concurrency.sh",
    "db:push:hosted:dry-run": "tsx scripts/db-push-hosted.ts",
    "db:push:hosted": "tsx scripts/db-push-hosted.ts --apply",
    "db:types": "node packages/types/scripts/generate-database-types.mjs",
    "db:types:hosted": "node packages/types/scripts/generate-database-types.mjs --hosted",
    "db:bootstrap": "tsx scripts/bootstrap-local-admin.ts",
    "db:bootstrap:hosted": "tsx scripts/bootstrap-hosted-admin.ts",
    "test:web": "tsx --test 'apps/web/**/*.test.{ts,tsx}'",
    "test:api-client": "tsx --test packages/api-client/test/api-client.test.ts",
    "test:validation": "tsx --test packages/validation/test/administration.test.ts",
    "test:session-api": "tsx scripts/test-session-api.ts",
    "test:session-api:hosted": "tsx scripts/test-hosted-session-api.ts",
    "test:local-scripts": "tsx --test scripts/local-supabase.test.ts",
    "test:hosted-scripts": "tsx --test scripts/hosted-database.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@poultry/api-client": "workspace:*",
    "@poultry/validation": "workspace:*",
    "@supabase/supabase-js": "2.119.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "supabase": "3.3.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
