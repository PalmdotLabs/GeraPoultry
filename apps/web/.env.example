# Hosted Supabase development project (replace placeholders; never use production credentials for local development).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy anonymous keys are also supported when no publishable key is supplied.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Non-secret canonical browser origin. Required in production for mutations and invitations.
# Development defaults to http://localhost:3000 when this is omitted.
APP_ORIGIN=http://localhost:3000

# The dev:web:local command supplies local Docker values automatically instead.

# Guided hosted-development setup only. Keep these server-only; never prefix them with NEXT_PUBLIC_.
# Use the Supavisor Session pooler PostgreSQL URL when the direct host requires unavailable IPv6.
SUPABASE_ENVIRONMENT=development
SUPABASE_DB_URL=postgresql://your-pooler-user:your-db-password@your-pooler-host:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
HOSTED_ADMIN_EMAIL=admin@example.com
HOSTED_ADMIN_PASSWORD=replace-with-a-development-only-password
